<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:background="@android:color/white"
    android:elevation="2dp"
    android:layout_margin="8dp">

    <ImageView
        android:id="@+id/voucher_image"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="12dp"
        android:src="@drawable/voucher"
        android:layout_gravity="center"
        android:contentDescription="Voucher Image" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/voucher_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Voucher Title"
            android:fontFamily="@font/akshar_medium"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"/>

        <TextView
            android:id="@+id/voucher_points"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Points: 100"
            android:fontFamily="@font/akshar_medium"
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray"/>

        <TextView
            android:id="@+id/voucher_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="Claimed on: 01 Jan 2025"
            android:fontFamily="@font/akshar_medium"
            android:textColor="@android:color/darker_gray"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
