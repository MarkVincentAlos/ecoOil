<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Profile">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="75dp"
            android:orientation="horizontal">


            <ImageButton
                android:id="@+id/back"
                android:layout_width="66dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:src="@drawable/back"
                android:paddingTop="20dp"
                android:background="@color/trans"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/akshar_medium"
                android:textSize="40dp"
                android:textAlignment="center"
                android:textColor="@color/black"
                android:paddingTop="20dp"
                android:paddingRight="40dp"
                android:text="@string/p_profile"
                android:layout_weight="1"
                android:textStyle="bold"/>

        </LinearLayout>



        <ImageView
            android:id="@+id/imageView4"
            android:layout_width="137dp"
            android:layout_height="145dp"
            android:layout_marginTop="10dp"
            android:layout_gravity="center_horizontal"
            android:src="@drawable/userfill" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/p_name"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/akshar_medium"
                android:drawableEnd="@drawable/edit"
                android:paddingTop="15dp"
                android:text="@string/p_name"
                android:textAlignment="center"
                android:textSize="30sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:id="@+id/p_number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/akshar_medium"
            android:layout_marginTop="30dp"
            android:paddingStart="20dp"
            android:textSize="20sp"
            android:text="@string/p_number" />

        <TextView
            android:id="@+id/p_number2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/abeezee"
            android:layout_marginTop="10dp"
            android:paddingStart="50dp"
            android:textSize="20sp"
            android:text="@string/p_number2" />

        <TextView
            android:id="@+id/p_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/akshar_medium"
            android:layout_marginTop="30dp"
            android:paddingStart="20dp"
            android:textSize="20sp"
            android:text="@string/p_email" />

        <TextView
            android:id="@+id/p_email2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/akshar_medium"
            android:layout_marginTop="10dp"
            android:paddingStart="50dp"
            android:textSize="20sp"
            android:text="@string/p_email2" />

        <TextView
            android:id="@+id/phone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:fontFamily="@font/akshar_medium"
            android:paddingStart="20dp"
            android:text="@string/phone"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/phone2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/akshar_medium"
            android:layout_marginTop="10dp"
            android:paddingStart="50dp"
            android:textSize="20sp"
            android:text="@string/phone2" />



    </LinearLayout>
</androidx.core.widget.NestedScrollView>