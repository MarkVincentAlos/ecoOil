<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".Help">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="HELP"
        android:textAlignment="center"
        android:textSize="50sp"
        android:textStyle="bold" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="400dp"
        android:layout_margin="20dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="5dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_margin="10dp"
            android:gravity="center">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:text=" Address: XFHJ+4P3, Urdaneta Junction - Dagupan Rd, Santa Barbara, Pangasinan"
                android:textSize="16sp"
                android:paddingStart="3dp"
                android:clickable="true"
                app:drawableStartCompat="@drawable/location" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_margin="5dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:text=" Offerings: Car wash · Diesel gas"
                android:textSize="16sp"
                android:paddingStart="3dp"
                android:clickable="true"
                app:drawableLeftCompat="@drawable/offerings" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_margin="5dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:paddingStart="3dp"
                android:text=" Phone: 09493473888"
                android:textSize="16sp"
                android:clickable="true"
                app:drawableStartCompat="@drawable/phone" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_margin="5dp" />
        </LinearLayout>



    </androidx.cardview.widget.CardView>



</LinearLayout>