<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".DieselGas">

    <!-- Price Display Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Diesel Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingVertical="8dp">

            <!-- Diesel Label -->
            <TextView
                android:id="@+id/diesel_label"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:gravity="end"
                android:text="Diesel"
                android:textAlignment="textStart"
                android:textColor="@color/purple2"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Diesel Price Digits -->
            <LinearLayout
                android:id="@+id/diesel_price_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView android:id="@+id/diesel_digit_1" style="@style/PriceDigit"/>
                <TextView android:id="@+id/diesel_digit_2" style="@style/PriceDigit"/>
                <TextView android:id="@+id/diesel_dot" style="@style/PriceDigit" android:text="." android:textColor="@color/black"/>
                <TextView android:id="@+id/diesel_digit_3" style="@style/PriceDigit"/>
                <TextView android:id="@+id/diesel_digit_4" style="@style/PriceDigit"/>
            </LinearLayout>

            <!-- Diesel Price Change Container -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginStart="16dp">

                <!-- Diesel Price Change Icon -->
                <ImageView
                    android:id="@+id/diesel_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:visibility="gone"/>

                <!-- Diesel Price Change Text -->
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/darkgrey"
            android:layout_margin="10dp"/>

        <!-- Gasoline Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingVertical="8dp">

            <!-- Gasoline Label -->
            <TextView
                android:id="@+id/gasoline_label"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:gravity="end"
                android:text="Gasoline"
                android:textAlignment="textStart"
                android:textColor="@color/purple2"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Gasoline Price Digits -->
            <LinearLayout
                android:id="@+id/gasoline_price_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView android:id="@+id/gasoline_digit_1" style="@style/PriceDigit"/>
                <TextView android:id="@+id/gasoline_digit_2" style="@style/PriceDigit"/>
                <TextView android:id="@+id/gasoline_dot" style="@style/PriceDigit" android:text="." android:textColor="@color/black"/>
                <TextView android:id="@+id/gasoline_digit_3" style="@style/PriceDigit"/>
                <TextView android:id="@+id/gasoline_digit_4" style="@style/PriceDigit"/>
            </LinearLayout>

            <!-- Gasoline Price Change Container -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginStart="16dp">

                <!-- Gasoline Price Change Icon -->
                <ImageView
                    android:id="@+id/gasoline_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:visibility="gone"/>

                <!-- Gasoline Price Change Text -->
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
