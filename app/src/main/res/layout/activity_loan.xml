<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    tools:context=".transfer">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="97dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/back"
                android:layout_width="33dp"
                android:layout_height="33dp"
                android:layout_marginLeft="3dp"
                android:layout_marginTop="22dp"
                android:src="@drawable/back_button" />

            <TextView
                android:id="@+id/loanpage"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="30dp"
                android:fontFamily="@font/abeezee"
                android:paddingLeft="75dp"
                android:text="@string/loan"
                android:textColor="#1AA7EC"
                android:textSize="35sp" />



        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:layout_marginTop="60dp"
            android:layout_width="380dp"
            android:layout_height="50dp"
            android:layout_gravity="center"
            app:cardCornerRadius="10dp"
            app:cardElevation="10dp"
            >

            <EditText
                android:id="@+id/l_amount"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="null"
                android:ems="10"
                android:hint="@string/l_amount"
                android:fontFamily="@font/abeezee"
                android:inputType="number"
                android:paddingStart="10dp"
                android:text="" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_marginTop="30dp"
            android:layout_width="380dp"
            android:layout_height="50dp"
            android:layout_gravity="center"
            app:cardCornerRadius="10dp"
            app:cardElevation="10dp"
            >

            <EditText
                android:id="@+id/card_number"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="null"
                android:ems="10"
                android:hint="@string/card_number"
                android:fontFamily="@font/abeezee"
                android:inputType="number"
                android:paddingStart="10dp"
                android:text="" />


        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_marginTop="40dp"
            android:layout_width="380dp"
            android:layout_height="50dp"
            android:layout_gravity="center"
            app:cardCornerRadius="10dp"
            app:cardElevation="10dp">

            <EditText
                android:id="@+id/d_amount"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="null"
                android:ems="10"
                android:hint="@string/d_amount"
                android:fontFamily="@font/abeezee"
                android:inputType="number"
                android:paddingStart="10dp"
                android:text="" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_marginTop="40dp"
            android:layout_width="380dp"
            android:layout_height="50dp"
            android:layout_gravity="center"
            app:cardCornerRadius="10dp"
            app:cardElevation="10dp">

            <EditText
                android:id="@+id/d_message"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="null"
                android:ems="10"
                android:hint="@string/d_message"
                android:fontFamily="@font/abeezee"
                android:inputType="number"
                android:paddingStart="10dp"
                android:text="" />
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/t_confirm"
            android:layout_width="190dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:layout_gravity="center"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1AA7EC"
            android:text="@string/d_confirm" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>