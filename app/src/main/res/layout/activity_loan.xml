<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    tools:context=".transfer">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="97dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/back"
                android:layout_width="33dp"
                android:layout_height="33dp"
                android:layout_marginLeft="3dp"
                android:layout_marginTop="22dp"
                android:src="@drawable/back_button" />

            <TextView
                android:id="@+id/loanpage"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="30dp"
                android:fontFamily="@font/abeezee"
                android:paddingLeft="125dp"
                android:text="@string/loan"
                android:textColor="#1AA7EC"
                android:textSize="35sp" />



        </LinearLayout>

        <TextView
            android:id="@+id/l_amount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/l_amount"
            android:textColor="#1AA7EC"
            android:fontFamily="@font/abeezee"
            android:textSize="19sp"
            android:layout_marginStart="30dp"
            android:layout_marginBottom="5dp"/>

        <androidx.cardview.widget.CardView
            android:layout_width="260dp"
            android:layout_height="50dp"
            android:layout_gravity="start"
            android:layout_marginStart="30dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="10dp">

            <EditText
                android:id="@+id/l_amount2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="null"
                android:ems="10"
                android:fontFamily="@font/abeezee"
                android:hint="@string/l_amount2"
                android:inputType="number"
                android:paddingStart="10dp"
                android:text="" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/l_income"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/l_income"
            android:textColor="#1AA7EC"
            android:fontFamily="@font/abeezee"
            android:textSize="19sp"
            android:layout_marginStart="30dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="5dp"/>

        <androidx.cardview.widget.CardView
            android:layout_width="260dp"
            android:layout_height="50dp"
            android:layout_marginStart="30dp"
            android:layout_gravity="start"
            app:cardCornerRadius="10dp"
            app:cardElevation="10dp">

            <EditText
                android:id="@+id/l_income2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="null"
                android:ems="10"
                android:fontFamily="@font/abeezee"
                android:hint="@string/l_income2"
                android:inputType="number"
                android:paddingStart="10dp"
                android:text="" />


        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/l_contacts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/l_contacts"
            android:layout_marginTop="20dp"
            android:layout_marginLeft="5dp"
            android:textStyle="bold"
            android:textSize="25sp"/>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/l_name"
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="5dp"
                android:fontFamily="@font/abeezee"
                android:text="@string/l_name"
                android:textColor="#1AA7EC"
                android:textSize="19sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:layout_gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.cardview.widget.CardView
                android:layout_width="180dp"
                android:layout_height="43dp"
                android:layout_marginStart="15dp"
                android:layout_marginTop="3dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="10dp">

                <EditText
                    android:id="@+id/l_first"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="null"
                    android:ems="10"
                    android:fontFamily="@font/abeezee"
                    android:hint="@string/l_first"
                    android:inputType="number"
                    android:paddingStart="10dp"
                    android:text="" />
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="180dp"
                android:layout_height="43dp"
                android:layout_marginStart="25dp"
                android:layout_marginTop="3dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="10dp">

                <EditText
                    android:id="@+id/l_last"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="null"
                    android:ems="10"
                    android:fontFamily="@font/abeezee"
                    android:hint="@string/l_last"
                    android:inputType="number"
                    android:paddingStart="10dp"
                    android:text="" />
            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <TextView
            android:id="@+id/l_birth"
            android:layout_width="180dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_marginBottom="5dp"
            android:fontFamily="@font/abeezee"
            android:text="@string/l_birth"
            android:textColor="#1AA7EC"
            android:textSize="19sp" />



        <androidx.cardview.widget.CardView
            android:layout_width="390dp"
            android:layout_height="43dp"
            android:layout_marginStart="15dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="10dp">

            <EditText
                android:id="@+id/l_birth2"
                android:layout_width="390dp"
                android:layout_height="match_parent"
                android:background="null"
                android:ems="10"
                android:fontFamily="@font/abeezee"
                android:hint="@string/l_birth2"
                android:inputType="date"
                android:paddingStart="10dp"
                android:text="" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/l_phone"
            android:layout_width="180dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_marginBottom="5dp"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/abeezee"
            android:text="@string/l_phone"
            android:textColor="#1AA7EC"
            android:textSize="19sp" />

        <androidx.cardview.widget.CardView
            android:layout_width="390dp"
            android:layout_height="43dp"
            android:layout_marginStart="15dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="10dp">

            <EditText
                android:id="@+id/l_phone2"
                android:layout_width="390dp"
                android:layout_height="match_parent"
                android:background="null"
                android:ems="10"
                android:fontFamily="@font/abeezee"
                android:hint="@string/l_phone2"
                android:inputType="number"
                android:paddingStart="10dp"
                android:text="" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/l_marital"
            android:layout_width="180dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_marginBottom="5dp"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/abeezee"
            android:text="@string/l_marital"
            android:textColor="#1AA7EC"
            android:textSize="19sp" />

        <Spinner
            android:id="@+id/l_marital2"
            android:layout_marginStart="10dp"
            android:layout_width="193dp"
            android:layout_height="43dp" />

        <TextView
            android:id="@+id/l_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/l_address"
            android:layout_marginTop="20dp"
            android:layout_marginLeft="5dp"
            android:textStyle="bold"
            android:textSize="25sp"/>

        <TextView
            android:id="@+id/l_street"
            android:layout_width="180dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_marginBottom="5dp"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/abeezee"
            android:text="@string/l_street"
            android:textColor="#1AA7EC"
            android:textSize="19sp" />

        <androidx.cardview.widget.CardView
            android:layout_width="390dp"
            android:layout_height="43dp"
            android:layout_marginStart="15dp"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="10dp">

            <EditText
                android:id="@+id/l_street2"
                android:layout_width="390dp"
                android:layout_height="match_parent"
                android:background="null"
                android:ems="10"
                android:inputType="text"
                android:paddingStart="10dp"
                android:text="" />
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/l_city"
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="5dp"
                android:fontFamily="@font/abeezee"
                android:text="@string/l_city"
                android:textColor="#1AA7EC"
                android:textSize="19sp" />

            <TextView
                android:id="@+id/l_state"
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="25dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="5dp"
                android:fontFamily="@font/abeezee"
                android:text="@string/l_state"
                android:textColor="#1AA7EC"
                android:textSize="19sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:layout_gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.cardview.widget.CardView
                android:layout_width="180dp"
                android:layout_height="43dp"
                android:layout_marginStart="15dp"
                android:layout_marginTop="3dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="10dp">

                <EditText
                    android:id="@+id/l_city2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="null"
                    android:ems="10"
                    android:inputType="text"
                    android:paddingStart="10dp"
                    android:text="" />
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="180dp"
                android:layout_height="43dp"
                android:layout_marginStart="25dp"
                android:layout_marginTop="3dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="10dp">

                <EditText
                    android:id="@+id/l_state2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="null"
                    android:ems="10"
                    android:inputType="text"
                    android:paddingStart="10dp"
                    android:text="" />
            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <TextView
            android:id="@+id/l_postal"
            android:layout_width="180dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="5dp"
            android:fontFamily="@font/abeezee"
            android:text="@string/l_postal"
            android:textColor="#1AA7EC"
            android:textSize="19sp" />
        <androidx.cardview.widget.CardView
            android:layout_width="180dp"
            android:layout_height="43dp"
            android:layout_marginStart="15dp"
            android:layout_marginTop="3dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="10dp">

            <EditText
                android:id="@+id/l_postal2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="null"
                android:ems="10"
                android:inputType="number"
                android:paddingStart="10dp"
                android:text="" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/l_live"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="5dp"
            android:fontFamily="@font/abeezee"
            android:text="@string/l_live"
            android:textColor="#1AA7EC"
            android:textSize="19sp" />
        <Spinner
            android:id="@+id/l_live2"
            android:layout_marginStart="10dp"
            android:layout_width="193dp"
            android:layout_height="43dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/l_gross"
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="5dp"
                android:fontFamily="@font/abeezee"
                android:text="@string/l_gross"
                android:textColor="#1AA7EC"
                android:textSize="19sp" />

            <TextView
                android:id="@+id/l_rent"
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="25dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="5dp"
                android:fontFamily="@font/abeezee"
                android:text="@string/l_rent"
                android:textColor="#1AA7EC"
                android:textSize="19sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:layout_gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.cardview.widget.CardView
                android:layout_width="180dp"
                android:layout_height="43dp"
                android:layout_marginStart="15dp"
                android:layout_marginTop="3dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="10dp">

                <EditText
                    android:id="@+id/l_gross2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="null"
                    android:ems="10"
                    android:inputType="text"
                    android:paddingStart="10dp"
                    android:text="" />
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="180dp"
                android:layout_height="43dp"
                android:layout_marginStart="25dp"
                android:layout_marginTop="3dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="10dp">

                <EditText
                    android:id="@+id/l_rent2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="null"
                    android:ems="10"
                    android:inputType="text"
                    android:paddingStart="10dp"
                    android:text="" />
            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <TextView
            android:id="@+id/l_down"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="5dp"
            android:fontFamily="@font/abeezee"
            android:text="@string/l_down"
            android:textColor="#1AA7EC"
            android:textSize="19sp" />
        <androidx.cardview.widget.CardView
            android:layout_width="180dp"
            android:layout_height="43dp"
            android:layout_marginStart="15dp"
            android:layout_marginTop="3dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="10dp">

            <EditText
                android:id="@+id/l_down2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="null"
                android:ems="10"
                android:inputType="number"
                android:paddingStart="10dp"
                android:text="" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/l_consent"
            android:layout_width="180dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_marginTop="50dp"
            android:layout_marginBottom="5dp"
            android:fontFamily="@font/abeezee"
            android:text="@string/consent"
            android:textColor="#1AA7EC"
            android:textSize="19sp" />


        <TextView
            android:id="@+id/l_consent2"
            android:layout_width="394dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="5dp"
            android:fontFamily="@font/abeezee"
            android:text="@string/consent2"
            android:textColor="#000000"
            android:textSize="15sp" />

        <CheckBox
            android:id="@+id/l_yes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/yes_radio"/>

        <TextView
            android:id="@+id/l_consent3"
            android:layout_width="394dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="5dp"
            android:fontFamily="@font/abeezee"
            android:text="@string/consent3"
            android:textColor="#000000"
            android:textSize="15sp" />

        <CheckBox
            android:id="@+id/l_yes2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/yes_radio"/>

        <Button
            android:id="@+id/t_confirm"
            android:layout_width="190dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="40dp"
            android:backgroundTint="#1AA7EC"
            android:gravity="center"
            android:text="@string/d_confirm"
            android:textColor="#FFFFFF" />



    </LinearLayout>
</androidx.core.widget.NestedScrollView>