<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    tools:context=".transfer">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="75dp"
            android:orientation="horizontal"
            android:background="@drawable/topdesign">

            <ImageView
                android:layout_marginTop="10dp"
                android:layout_marginLeft="3dp"
                android:id="@+id/back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/back_button"/>

            <TextView
                android:id="@+id/transferpage"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="30dp"
                android:paddingLeft="55dp"
                android:text="@string/transfer"
                android:textColor="#FFFFFF"
                android:textSize="40sp"
                android:textStyle="bold" />

        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:layout_marginTop="30dp"
            android:layout_width="380dp"
            android:layout_height="178dp"
            android:layout_gravity="center"
            app:cardElevation="50dp"
            app:cardCornerRadius="10dp">

            <TextView
                android:id="@+id/deposit_balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10sp"
                android:fontFamily="@font/abeezee"
                android:text="@string/deposit_balance"
                android:textSize="25sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/imageView2"
                android:layout_width="43dp"
                android:layout_height="57dp"
                android:layout_marginLeft="30dp"
                android:layout_marginTop="40dp"
                app:srcCompat="@drawable/sim" />

            <TextView
                android:id="@+id/textView"
                android:layout_width="wrap_content"
                android:layout_height="57dp"
                android:layout_marginLeft="30dp"
                android:layout_marginTop="90dp"
                android:text="@string/credit"
                android:textSize="40dp" />

            <ImageView
                android:id="@+id/imageView3"
                android:layout_marginTop="120dp"
                android:layout_marginLeft="290dp"
                android:layout_width="83dp"
                android:layout_height="60dp"
                app:srcCompat="@drawable/visa" />

            <TextView
                android:id="@+id/textView2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="30dp"
                android:layout_marginTop="140dp"
                android:fontFamily="@font/abeezee"
                android:text="@string/c_name" />


        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_marginTop="60dp"
            android:layout_width="380dp"
            android:layout_height="50dp"
            android:layout_gravity="center"
            app:cardCornerRadius="10dp"
            app:cardElevation="10dp"
            >

            <EditText
                android:id="@+id/biller"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="null"
                android:ems="10"
                android:hint="@string/biller"
                android:fontFamily="@font/abeezee"
                android:inputType="number"
                android:paddingStart="10dp"
                android:text="" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_marginTop="30dp"
            android:layout_width="380dp"
            android:layout_height="50dp"
            android:layout_gravity="center"
            app:cardCornerRadius="10dp"
            app:cardElevation="10dp"
            >

            <EditText
                android:id="@+id/card_number"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="null"
                android:ems="10"
                android:hint="@string/card_number"
                android:fontFamily="@font/abeezee"
                android:inputType="number"
                android:paddingStart="10dp"
                android:text="" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_marginTop="40dp"
            android:layout_width="380dp"
            android:layout_height="50dp"
            android:layout_gravity="center"
            app:cardCornerRadius="10dp"
            app:cardElevation="10dp">

            <EditText
                android:id="@+id/d_amount"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="null"
                android:ems="10"
                android:hint="@string/d_amount"
                android:fontFamily="@font/abeezee"
                android:inputType="number"
                android:paddingStart="10dp"
                android:text="" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_marginTop="40dp"
            android:layout_width="380dp"
            android:layout_height="50dp"
            android:layout_gravity="center"
            app:cardCornerRadius="10dp"
            app:cardElevation="10dp">

            <EditText
                android:id="@+id/d_message"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="null"
                android:ems="10"
                android:hint="@string/d_message"
                android:fontFamily="@font/abeezee"
                android:inputType="number"
                android:paddingStart="10dp"
                android:text="" />
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/t_confirm"
            android:layout_width="190dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:layout_gravity="center"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1AA7EC"
            android:text="@string/d_confirm" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>