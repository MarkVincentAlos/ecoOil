<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    tools:context=".Home">

    <androidx.cardview.widget.CardView
        android:layout_width="380dp"
        android:layout_height="178dp"
        android:layout_gravity="center"
        android:layout_marginStart="19dp"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="19dp"
        app:cardCornerRadius="10dp"
        app:cardElevation="50dp">

        <ImageView
            android:id="@+id/card_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/background"
            android:scaleType="centerCrop"/>

        <TextView
            android:id="@+id/l_balance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10sp"
            android:fontFamily="@font/abeezee"
            android:text="@string/deposit_balance"
            android:textColor="@color/white"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textView2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="140dp"
            android:fontFamily="@font/abeezee"
            android:textColor="@color/white"
            android:text="@string/c_name" />

        <TextView
            android:id="@+id/editTextText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="110dp"
            android:layout_marginTop="70dp"
            android:background="@color/transparent"
            android:ems="10"
            android:fontFamily="@font/abeezee"
            android:textColor="@color/white"
            android:inputType="text"
            android:text="@string/amount_balance"
            android:textSize="25sp" />
    </androidx.cardview.widget.CardView>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">



        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="194dp"
            android:layout_margin="19dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:layout_margin="5dp">

                    <TextView
                        android:id="@+id/sations"
                        android:layout_width="336dp"
                        android:layout_height="wrap_content"
                        android:text="@string/stations" />

                    <ImageButton
                        android:id="@+id/gostation"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/trans"
                        android:src="@drawable/go" />
            </LinearLayout>

                <androidx.fragment.app.FragmentContainerView
                    android:id="@id/map"
                    android:name="com.google.android.gms.maps.SupportMapFragment"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/c_recent"
            android:layout_width="339dp"
            android:layout_height="match_parent"
            android:fontFamily="@font/abeezee"
            android:paddingStart="10dp"
            android:paddingTop="2dp"
            android:text="@string/c_recent"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/c_time"
            android:layout_width="72dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/time" />
    </LinearLayout>

    </LinearLayout>

</LinearLayout>