<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    tools:context=".Home">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="75dp"
        android:src="@drawable/logo"
        android:background="@drawable/topdesign"/>

    <androidx.cardview.widget.CardView
        android:layout_width="380dp"
        android:layout_height="178dp"
        android:layout_gravity="center"
        android:layout_marginStart="16dp"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="19dp"
        app:cardCornerRadius="10dp"
        app:cardElevation="50dp">

        <ImageView
            android:id="@+id/card_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/background"
            android:scaleType="centerCrop"/>

        <TextView
            android:id="@+id/l_balance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10sp"
            android:fontFamily="@font/abeezee"
            android:text="@string/deposit_balance"
            android:textSize="25sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/imageView2"
            android:layout_width="43dp"
            android:layout_height="48dp"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="43dp"
            app:srcCompat="@drawable/sim" />

        <TextView
            android:id="@+id/textView"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="95dp"
            android:text="@string/credit"
            android:textSize="40dp" />

        <ImageView
            android:id="@+id/imageView3"
            android:layout_width="83dp"
            android:layout_height="60dp"
            android:layout_marginLeft="290dp"
            android:layout_marginTop="120dp"
            app:srcCompat="@drawable/visa" />

        <TextView
            android:id="@+id/textView2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="140dp"
            android:fontFamily="@font/abeezee"
            android:text="@string/c_name" />

        <TextView
            android:id="@+id/editTextText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="140dp"
            android:layout_marginTop="50dp"
            android:background="@color/transparent"
            android:ems="10"
            android:fontFamily="@font/abeezee"
            android:inputType="text"
            android:text="@string/amount_balance"
            android:textSize="25sp" />
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="20dp">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal">z

            <ImageButton
                android:id="@+id/h_deposit"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:background="@color/transparent"
                android:maxWidth="32dp"
                android:maxHeight="32dp"
                android:scaleType="fitCenter"
                android:src="@drawable/deposit" />

            <TextView
                android:id="@+id/tv_deposit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Deposit"
                android:textSize="12sp"
                android:textAlignment="center"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal">

            <ImageButton
                android:id="@+id/h_loans"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:background="@color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/loan"
                android:maxWidth="32dp"
                android:maxHeight="32dp" />

            <TextView
                android:id="@+id/tv_loans"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Loans"
                android:textSize="12sp"
                android:textAlignment="center"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal">

            <ImageButton
                android:id="@+id/h_transfer"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:background="@color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/transfer"
                android:maxWidth="32dp"
                android:maxHeight="32dp" />

            <TextView
                android:id="@+id/tv_transfer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Transfer"
                android:textSize="12sp"
                android:textAlignment="center"
                android:layout_marginTop="4dp" />
        </LinearLayout>

    </LinearLayout>



    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/c_recent"
                android:layout_width="339dp"
                android:layout_height="match_parent"
                android:fontFamily="@font/abeezee"
                android:paddingStart="10dp"
                android:paddingTop="2dp"
                android:text="@string/c_recent"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/c_time"
                android:layout_width="72dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:src="@drawable/time" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>