<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="10dp"
    android:layout_marginBottom="10dp"
    android:background="?android:attr/selectableItemBackground">

    <TextView
        android:id="@+id/reward_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Reward Title"
        android:fontFamily="@font/akshar_medium"
        android:textColor="@color/black"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/reward_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Description of the reward goes here."
        android:fontFamily="@font/akshar_medium"
        android:textColor="@color/black"
        android:textSize="14sp"
        android:layout_marginTop="5dp" />

    <TextView
        android:id="@+id/reward_price"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Price: 0 Points"
        android:fontFamily="@font/akshar_medium"
        android:textStyle="bold"
        android:textAlignment="textEnd"
        android:textColor="@color/black"
        android:textSize="16sp" />

</LinearLayout>
